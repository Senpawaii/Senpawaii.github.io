---
import Chibi from './Chibi.astro';
import Machine from './Machine.astro';
const colors: Record<string, string> = { about: '#c0510f', stack: '#2f6fb5', resume: '#7d4fb8', contact: '#c0392b', projects: '#237a6f' };
const m = (id: string) => ({ id: id as any, color: colors[id] });
---
<div class="backdrop" aria-hidden="true">
<div class="floor">
  <svg class="floor-art" viewBox="0 0 1600 900" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <pattern id="tiles" width="80" height="80" patternUnits="userSpaceOnUse">
        <rect width="80" height="80" fill="#efe5d1" /><path d="M80 0H0V80" fill="none" stroke="#e1d4ba" stroke-width="3" />
      </pattern>
      <pattern id="hazard" width="40" height="40" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="40" height="40" fill="#f5b82e" /><rect width="20" height="40" fill="#2b2a28" />
      </pattern>
    </defs>
    <rect width="1600" height="900" fill="url(#tiles)" />
    <!-- back wall: skylights, overhead pipe and lamps -->
    <rect width="1600" height="56" fill="#d9ccb2" /><rect y="52" width="1600" height="6" fill="#2b2a28" opacity=".7" />
    <g fill="#cfe9ee" stroke="#2b2a28" stroke-width="3">
      {[0, 1, 2, 3, 4].map((i) => <rect x={110 + i * 310} y="10" width="170" height="30" rx="5" />)}
    </g>
    <!-- walkway between the two lines -->
    <rect y="403" width="1600" height="104" fill="#2b2a28" opacity=".05" />
    <path d="M0 405H1600M0 505H1600" stroke="#f5b82e" stroke-width="4" stroke-dasharray="26 18" />
    <!-- bottom edge -->
    <rect y="855" width="1600" height="45" fill="#d9ccb2" /><rect y="855" width="1600" height="10" fill="url(#hazard)" opacity=".85" />
  </svg>

  <!-- two conveyor lines joined by a vertical pipe -->
  <div class="belt belt-1"></div>
  <div class="belt belt-2"></div>
  <div class="belt belt-pipe"></div>
  <span class="roller roller-a"></span><span class="roller roller-b"></span>

  <div class="slot slot-about"><Machine {...m('about')} /></div>
  <div class="slot slot-stack"><Machine {...m('stack')} /></div>
  <div class="slot slot-resume"><Machine {...m('resume')} /></div>
  <div class="slot slot-contact"><Machine {...m('contact')} /></div>
  <div class="slot slot-projects"><Machine {...m('projects')} /></div>

  <div class="gate" aria-hidden="true"><i></i><i></i><b>QA</b></div>

  <div class="crates" aria-hidden="true">
    {[0, 1, 2, 3, 4].map((i) => <span class="crate" style={`--i:${i}`}><i></i></span>)}
  </div>

  <Chibi class="r-planner" kind="plip" tool="clipboard" label="Plip · Planner" delay={0} />
  <Chibi class="r-builder" kind="sparko" tool="wrench" label="Sparko · Builder" delay={0.6} />
  <Chibi class="r-reviewer" kind="sprig" tool="lens" label="Sprig · Reviewer" delay={1.1} />
  <Chibi class="r-tester" kind="wisp" tool="flag" label="Wisp · Tester" delay={1.6} />
  <Chibi class="r-patrol" kind="hardy" label="Hardy · Foreman" delay={0.3} />

</div>
</div>
