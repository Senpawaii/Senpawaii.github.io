---
import type { StationId } from '../data/content';
interface Props { id: StationId; label: string; sub: string; k: string; color: string }
const { id, label, sub, k, color } = Astro.props;

const K = '#2b2a28';
const S = `stroke="${K}" stroke-width="3.5" stroke-linejoin="round" stroke-linecap="round"`;

// a toothed gear as a polygon plus a hub
const gear = (cx: number, cy: number, r: number, n: number, fill: string, cls: string) => {
  const p = (Math.PI * 2) / n;
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    for (const [a, rr] of [[0, r], [0.12, r + 8], [0.38, r + 8], [0.5, r]] as const) {
      const ang = (i + a) * p;
      pts.push(`${(cx + Math.cos(ang) * rr).toFixed(1)},${(cy + Math.sin(ang) * rr).toFixed(1)}`);
    }
  }
  return `<g class="${cls}"><polygon points="${pts.join(' ')}" fill="${fill}" ${S}/><circle cx="${cx}" cy="${cy}" r="${r * 0.32}" fill="#fbf6ec" ${S}/></g>`;
};

const art: Record<StationId, { vb: string; svg: string }> = {
  // control tower on stilts
  about: {
    vb: '0 0 230 150',
    svg: `
    <g ${S}>
      <rect x="40" y="104" width="9" height="44" fill="#9fb0bd"/><rect x="181" y="104" width="9" height="44" fill="#9fb0bd"/>
      <path d="M49 108L181 146M181 108L49 146" fill="none" stroke="#7d8b97" stroke-width="4"/>
      <rect x="24" y="96" width="182" height="12" rx="4" fill="#9fb0bd"/>
      <rect x="34" y="34" width="162" height="64" rx="8" fill="#fbf6ec"/>
      <rect x="112" y="11" width="6" height="6" fill="#9fb0bd" stroke-width="2.5"/>
      <path d="M24 38L40 16H190L206 38Z" fill="var(--s)"/>
      <rect x="46" y="44" width="138" height="40" rx="5" fill="#cfe9ee"/>
      <rect x="58" y="72" width="114" height="9" rx="2" fill="#b98c5a"/>
      <rect x="68" y="54" width="32" height="20" rx="3" fill="${K}"/><rect x="130" y="54" width="32" height="20" rx="3" fill="${K}"/>
    </g>
    <g class="blink"><path d="M73 60h22M73 66h14M135 60h22M135 66h10" stroke="#7fe3c9" stroke-width="3" stroke-linecap="round"/></g>
    <circle class="beacon" cx="115" cy="7" r="6.5" fill="#f5b82e" ${S} stroke-width="2.6"/>`,
  },
  // gears, piston and chimney
  stack: {
    vb: '0 0 330 150',
    svg: `
    <g ${S}>
      <rect x="30" y="20" width="24" height="36" fill="#9fb0bd"/>
      <rect x="10" y="52" width="310" height="94" rx="10" fill="#dbe7f5"/>
      <rect x="10" y="52" width="310" height="16" rx="8" fill="var(--s)"/>
      <rect x="26" y="72" width="178" height="66" rx="8" fill="#3f4a54"/>
    </g>
    ${gear(78, 106, 24, 10, '#f5b82e', 'spin')}
    ${gear(132, 90, 16, 8, '#e8742c', 'spin spin-rev')}
    ${gear(168, 116, 13, 7, '#9fb0bd', 'spin')}
    <g ${S}>
      <rect x="222" y="34" width="26" height="76" rx="5" fill="#9fb0bd"/>
      <g class="piston"><rect x="229" y="16" width="12" height="40" fill="#dfe6eb" stroke-width="3"/><rect x="221" y="10" width="28" height="10" rx="3" fill="#5d6b78"/></g>
      <rect x="262" y="74" width="48" height="58" rx="6" fill="#fbf6ec"/>
    </g>
    <circle class="blink" cx="276" cy="88" r="5" fill="#d9534f" ${S} stroke-width="2.4"/>
    <circle class="blink b2" cx="294" cy="88" r="5" fill="#f5b82e" ${S} stroke-width="2.4"/>
    <circle cx="276" cy="106" r="5" fill="#7fd48f" ${S} stroke-width="2.4"/>
    <path d="M296 102v20" ${S} stroke-width="3"/><circle cx="296" cy="102" r="4.5" fill="#d9534f" ${S} stroke-width="2.4"/>
    <rect x="10" y="136" width="310" height="10" rx="3" fill="url(#hazard)" ${S} stroke-width="3"/>
    <g class="steam"><circle cx="42" cy="10" r="6" fill="#fff"/><circle class="s2" cx="46" cy="4" r="8" fill="#fff"/><circle class="s3" cx="38" cy="-2" r="5" fill="#fff"/></g>`,
  },
  // filing cabinet with paper feed and stamp
  resume: {
    vb: '0 0 220 150',
    svg: `
    <g class="paper"><rect x="90" y="8" width="40" height="38" rx="2" fill="#fff" ${S} stroke-width="3"/><path d="M97 18h26M97 25h26M97 32h16" stroke="${K}" stroke-width="2.4" stroke-linecap="round"/></g>
    <g ${S}>
      <rect x="44" y="40" width="132" height="106" rx="8" fill="#fbf6ec"/>
      <rect x="44" y="40" width="132" height="20" rx="8" fill="var(--s)"/>
      <rect x="78" y="36" width="64" height="9" rx="3" fill="${K}"/>
      ${[0, 1, 2].map((i) => `<rect x="56" y="${68 + i * 26}" width="108" height="20" rx="4" fill="#fff" stroke-width="3"/><rect x="98" y="${74 + i * 26}" width="24" height="7" rx="3.5" fill="#9fb0bd" stroke-width="2.4"/><rect x="62" y="${72 + i * 26}" width="16" height="11" rx="2" fill="#ffe9a8" stroke-width="2.2"/>`).join('')}
      <rect x="176" y="122" width="38" height="24" rx="4" fill="#7d8b97"/>
      <rect x="4" y="124" width="38" height="22" rx="4" fill="#9fb0bd"/>
      <rect x="8" y="112" width="30" height="14" rx="2" fill="#fff" stroke-width="3"/>
      <rect x="186" y="116" width="18" height="8" rx="2" fill="#d9534f" stroke-width="2.4"/>
    </g>
    <g class="stamp" ${S}><rect x="191" y="40" width="8" height="46" fill="#7d8b97" stroke-width="3"/><rect x="183" y="84" width="24" height="10" rx="3" fill="#d9534f" stroke-width="3"/></g>`,
  },
  // loading dock with roll-up door and crane
  projects: {
    vb: '0 0 330 150',
    svg: `
    <g ${S}>
      <rect x="14" y="40" width="302" height="106" rx="6" fill="#e6f3ef"/>
      <rect x="8" y="24" width="314" height="26" rx="6" fill="var(--s)"/>
      <rect x="50" y="62" width="132" height="84" fill="#3f4a54"/>
      <rect x="62" y="122" width="28" height="24" fill="#e8b86a" stroke-width="3"/><rect x="94" y="122" width="28" height="24" fill="#e8b86a" stroke-width="3"/>
      <rect x="78" y="98" width="28" height="24" fill="#f0c98a" stroke-width="3"/><rect x="132" y="112" width="40" height="34" fill="#e8b86a" stroke-width="3"/>
      <rect x="50" y="62" width="132" height="32" fill="#cfd8de"/><path d="M50 72h132M50 82h132" stroke-width="2.4"/>
      <rect x="198" y="118" width="32" height="28" fill="#e8b86a" stroke-width="3"/><rect x="234" y="118" width="32" height="28" fill="#f0c98a" stroke-width="3"/>
      <rect x="216" y="90" width="32" height="28" fill="#e8b86a" stroke-width="3"/>
      <rect x="290" y="4" width="10" height="46" fill="#7d8b97"/><rect x="196" y="4" width="104" height="9" rx="3" fill="#7d8b97"/>
    </g>
    <text x="118" y="43" text-anchor="middle" fill="#fff" font-weight="900" font-size="17" letter-spacing="3">SHIPPING</text>
    <g class="swing" ${S}><path d="M208 13v38" stroke-width="3"/><rect x="195" y="50" width="26" height="22" fill="#f0c98a" stroke-width="3"/></g>`,
  },
  // radio mast and mail cabin
  contact: {
    vb: '0 0 200 150',
    svg: `
    <g ${S}>
      <path d="M100 16L74 100M100 16L126 100M86 56H114M80 76H120M92 36H108" fill="none" stroke-width="3.2"/>
      <path d="M84 16q16 22 32 0z" fill="#fbf6ec" stroke-width="3"/>
      <rect x="24" y="98" width="152" height="48" rx="8" fill="#fbf6ec"/>
      <rect x="18" y="90" width="164" height="14" rx="6" fill="var(--s)"/>
      <rect x="38" y="112" width="48" height="24" rx="4" fill="#cfe9ee" stroke-width="3"/>
      <path d="M42 116l20 12l20-12" fill="none" stroke-width="2.6"/>
      <rect x="116" y="110" width="44" height="28" rx="7" fill="var(--s)"/><path d="M126 120h24" stroke-width="3"/>
    </g>
    <circle cx="100" cy="12" r="4.5" fill="#f5b82e" ${S} stroke-width="2.4"/>
    <g fill="none" stroke="${K}" stroke-width="3" stroke-linecap="round"><path class="ping" d="M76 6q-9 7 0 14"/><path class="ping p2" d="M124 6q9 7 0 14"/><path class="ping p3" d="M68 2q-14 11 0 22"/><path class="ping p4" d="M132 2q14 11 0 22"/></g>`,
  },
};
---
<button class="station" data-station={id} style={`--s:${color}`} aria-haspopup="dialog">
  <span class="sign"><kbd aria-hidden="true">{k}</kbd><span class="sign-text"><b>{label}</b><small>{sub}</small></span></span>
  <svg class="machine" viewBox={art[id].vb} aria-hidden="true" preserveAspectRatio="xMidYMax meet" set:html={art[id].svg} />
</button>
