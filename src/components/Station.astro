---
import type { StationId } from '../data/content';
interface Props { id: StationId; label: string; sub: string; k: string; color: string; class?: string }
const { id, label, sub, k, color, class: cls = '' } = Astro.props;
const icons: Record<StationId, string> = {
  about: '<circle cx="100" cy="68" r="9" fill="#fff8e8" stroke="#2b2a28" stroke-width="3"/><path d="M84 96q0-17 16-17t16 17z" fill="#fff8e8" stroke="#2b2a28" stroke-width="3" stroke-linejoin="round"/>',
  stack: '<circle cx="100" cy="82" r="14" fill="#fff8e8" stroke="#2b2a28" stroke-width="3"/><circle cx="100" cy="82" r="5" fill="#2b2a28"/><path d="M100 60v8M100 96v8M78 82h8M114 82h8M84 66l6 6M110 92l6 6M116 66l-6 6M90 92l-6 6" stroke="#2b2a28" stroke-width="4" stroke-linecap="round"/>',
  projects: '<path d="M76 74l24-12 24 12v26l-24 12-24-12z" fill="#fff8e8" stroke="#2b2a28" stroke-width="3" stroke-linejoin="round"/><path d="M76 74l24 12 24-12M100 86v26" fill="none" stroke="#2b2a28" stroke-width="3"/>',
  resume: '<rect x="80" y="62" width="40" height="50" rx="5" fill="#fff8e8" stroke="#2b2a28" stroke-width="3"/><path d="M88 76h24M88 87h24M88 98h14" stroke="#2b2a28" stroke-width="3.4" stroke-linecap="round"/>',
  contact: '<rect x="76" y="70" width="48" height="34" rx="6" fill="#fff8e8" stroke="#2b2a28" stroke-width="3"/><path d="M78 74l22 18 22-18" fill="none" stroke="#2b2a28" stroke-width="3" stroke-linejoin="round"/>',
};
---
<button class:list={['station', cls]} data-station={id} style={`--s:${color}`} aria-haspopup="dialog">
  <svg class="building" viewBox="0 0 200 150" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
    <rect x="14" y="40" width="172" height="104" rx="8" fill="#fbf6ec" stroke="#2b2a28" stroke-width="4" />
    <path d="M6 44L24 12h152l18 32z" fill="var(--s)" stroke="#2b2a28" stroke-width="4" stroke-linejoin="round" />
    <path d="M32 44l8-32M64 44l5-32M100 44V12M136 44l-5-32M168 44l-8-32" stroke="#fff" stroke-opacity=".45" stroke-width="5" />
    <rect x="26" y="56" width="34" height="26" rx="4" fill="#cfe9ee" stroke="#2b2a28" stroke-width="3" />
    <rect x="140" y="56" width="34" height="26" rx="4" fill="#cfe9ee" stroke="#2b2a28" stroke-width="3" />
    <g set:html={icons[id]} />
    <rect x="86" y="118" width="28" height="26" rx="3" fill="var(--s)" stroke="#2b2a28" stroke-width="3" />
  </svg>
  <span class="sign"><b>{label}</b><small>{sub}</small></span>
  <kbd aria-hidden="true">{k}</kbd>
</button>
