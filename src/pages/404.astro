---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · João Queirós</title>
    <meta name="robots" content="noindex" />
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  </head>
  <body>
    <Backdrop />
    <div class="page">
      <main class="card glass" style="height:auto;max-width:640px;padding:2.6rem 2.4rem;">
        <p class="tag" style="align-self:flex-start">404</p>
        <h1 style="font-family:var(--font-display);font-size:2.4rem;margin:.6rem 0 .4rem;letter-spacing:-.02em;">This page isn't on the line.</h1>
        <p style="margin:0 0 1.4rem;color:var(--ink-2)">The link may be old or mistyped. The rest of the site is one click away.</p>
        <a class="btn" style="align-self:flex-start" href="/">Back to the home page</a>
      </main>
    </div>
  </body>
</html>
